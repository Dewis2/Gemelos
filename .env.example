# Docker Compose: copiar a .env y reemplazar ambos CHANGE_ME.
# Backend nativo: usar .env.local.example. No versionar .env.
# Preferir una contraseña hexadecimal aleatoria para evitar escapes de URL.
POSTGRES_DB=digital_twin
POSTGRES_USER=digital_twin
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://digital_twin:CHANGE_ME@postgres:5432/digital_twin
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_ENABLED=false
DATA_ROOT=/data
# Persistencia de los agregados históricos.
DEMO_REPOSITORY=sqlalchemy
DEMO_ML_METADATA_PATH=/models/demo_peru/metadata.json
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
ML_MODEL_PATH=/app/models/traffic_model.joblib
SUMO_BINARY=sumo

CORE_REPOSITORY=sqlalchemy
