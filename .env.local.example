# Backend desde la raíz del repositorio, fuera de Docker.
# Copiar a .env si no existe y reemplazar ambos CHANGE_ME por la misma contraseña.
# Puerto 5433 para coexistir con otra instalación; ajustar al puerto real.
POSTGRES_DB=digital_twin
POSTGRES_USER=digital_twin
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://digital_twin:CHANGE_ME@127.0.0.1:5433/digital_twin
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_ENABLED=false
DATA_ROOT=data
# Persistencia de la API principal y de los datos históricos.
DEMO_REPOSITORY=sqlalchemy
DEMO_ML_METADATA_PATH=ml/models/demo_peru/metadata.json
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
ML_MODEL_PATH=ml/models/traffic_model.joblib
SUMO_BINARY=sumo

CORE_REPOSITORY=sqlalchemy
