@startuml
title Arquitectura hexagonal — backend
skinparam componentStyle rectangle
left to right direction

package "Driving adapters" {
  [FastAPI REST] as api
  [MQTT Consumer] as consumer
  [Demo Perú CLI] as cli
}
package "Application core" {
  interface "Inbound ports" as inbound
  [Use Cases] as usecases
  [Historical Replay] as replay
  interface "TrafficDatasetPort" as datasetport
  interface "Outbound ports" as outbound
  package Domain {
    [Entities]
    [Domain Rules]
  }
}
package "Driven adapters" {
  [Official Peru Dataset] as official
  [MTC / OSITRAN / Huancayo Adapters] as datasetadapters
  [SQLAlchemy / PostGIS] as db
  [joblib / scikit-learn] as ml
  [SUMO / TraCI] as sumo
  [MQTT Publisher] as publisher
}

api --> inbound
consumer --> inbound
cli --> inbound
inbound --> usecases
official --> datasetadapters
datasetadapters ..|> datasetport
datasetport --> usecases
usecases --> replay
replay --> publisher
replay --> db
usecases --> [Entities]
usecases --> [Domain Rules]
usecases --> outbound
db ..|> outbound
ml ..|> outbound
sumo ..|> outbound
publisher ..|> outbound
@enduml
